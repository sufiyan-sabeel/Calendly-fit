# =============================================================================
# Calendy Fit - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase Configuration
# ---------------------------------------------------------------------------
# Obtain from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://elevwhalcpkzjpeftoai.supabase.co
SUPABASE_ANON_KEY=sb_publishable_BwzBRjsTHNijFaTZGsHuMg_ykfKbw8H
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Mobile (Expo) - prefixed with EXPO_PUBLIC_
EXPO_PUBLIC_SUPABASE_URL=https://elevwhalcpkzjpeftoai.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_BwzBRjsTHNijFaTZGsHuMg_ykfKbw8H

# Web (Next.js) - prefixed with NEXT_PUBLIC_
NEXT_PUBLIC_SUPABASE_URL=https://elevwhalcpkzjpeftoai.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_BwzBRjsTHNijFaTZGsHuMg_ykfKbw8H
# Also supports PUBLISHABLE_KEY alias:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_BwzBRjsTHNijFaTZGsHuMg_ykfKbw8H

# ---------------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------------
# Obtain from: Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# ⚠️ Client Secret is SECRET — do NOT put in any .env file. Enter it only in Supabase Dashboard.
GOOGLE_CLIENT_ID=664719074795-41pajk4hb7c001sld26hqpjgus94h4bi.apps.googleusercontent.com

# Mobile Google Sign-In (Expo) — uses its own Android/iOS client ID, not the web one
# Create at: Google Cloud Console → Credentials → OAuth client ID → Android / iOS
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Web Google Sign-In (Next.js)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=664719074795-41pajk4hb7c001sld26hqpjgus94h4bi.apps.googleusercontent.com

# ---------------------------------------------------------------------------
# Google Calendar API
# ---------------------------------------------------------------------------
# Obtain from: Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID
# Must have https://www.googleapis.com/auth/calendar scope enabled
GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET goes only in Supabase Dashboard, never in .env files

EXPO_PUBLIC_GOOGLE_CALENDAR_API_KEY=AIzaSy...
NEXT_PUBLIC_GOOGLE_CALENDAR_API_KEY=AIzaSy...

# ---------------------------------------------------------------------------
# Google Maps Platform
# ---------------------------------------------------------------------------
# Obtain from: Google Cloud Console > APIs & Services > Credentials > API Key
# Restrict to: Maps SDK, Places API, Directions API
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...

# ---------------------------------------------------------------------------
# Google OAuth Redirect URIs
# ---------------------------------------------------------------------------
# Mobile: calendyfit://oauthredirect (custom scheme)
EXPO_GOOGLE_REDIRECT_URL=calendyfit://oauthredirect
# Web: https://your-domain.com/auth/callback
NEXT_PUBLIC_GOOGLE_REDIRECT_URL=http://localhost:3000/auth/callback

# ---------------------------------------------------------------------------
# Supabase Auth Redirect URLs (for OAuth)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_REDIRECT_URL=calendyfit://auth/callback
NEXT_PUBLIC_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# ---------------------------------------------------------------------------
# Stripe Payments (Optional)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---------------------------------------------------------------------------
# App Configuration
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Calendy Fit
NEXT_PUBLIC_APP_URL=http://localhost:3000
EXPO_PUBLIC_APP_NAME=Calendy Fit
