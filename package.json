{
  "name": "calendy-fit",
  "version": "1.0.0",
  "private": true,
  "description": "Calendy Fit - Premium fitness appointment scheduling platform",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:migrate": "supabase db push",
    "db:types": "supabase gen types typescript --local > packages/types/src/database.ts",
    "mobile": "cd apps/mobile && npx expo start",
    "web": "cd apps/web && pnpm dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "husky": "^9.0.0",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "supabase": "^1.191.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.4.0"
}
